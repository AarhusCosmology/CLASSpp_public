# CLASS++ precision preset: tuned -- most accurate setting that is still affordable
#
# Measured on 120 held-out Planck posterior draws, against a reference itself
# converged to S = 0.008:
#
#   S              0.3009   (spread of Delta chi^2; the headline metric)
#   bias           0.155 sigma
#   3-sigma worst  0.6763
#   cost           1.67x SLOWER than the defaults
#
# low-ell EE: this preset leaves k_step_super at the cheap rung, which puts
#   the ell = 2..29 EE residual at 1.58x the full-sky cosmic
#   variance of a multipole (chi^2-equivalent 13.3, against
#   0.0002 for the defaults). tau is measured there. Set
#       k_step_super = 0.002
#   before combining this with a low-ell EE likelihood; it costs ~10%.
#
# tensors: k_max_tau0_over_l_max = 1.2 truncates the k range
#   tensors need. Measured against a converged tensor reference, tensor BB
#   is ~11% wrong over ell = 30..300 (the defaults are 2.0%). Tensor TT is
#   unaffected. Set
#       k_max_tau0_over_l_max = 1.8
#   if you use tensor B-modes; it costs about 28%.
#
# lensing: delta_l_max = 250 halves the headroom the lensed spectrum
#   has at the top of the range you ask for. At l_max_scalars = 2500 the lensed
#   TT error reaches 7.5% in the last 50 multipoles (2.5% at delta_l_max = 500),
#   and raw_cl() returns a shorter array. Ask for l_max_scalars ~250 higher than
#   you need, or set delta_l_max = 500.
#
# Calibrated for flat LambdaCDM + 2 massless nu + 1 massive NCDM,
# output = tCl,pCl,lCl with lensing, no mPk and no nonlinear correction.
# The nonlinear sector was never exercised. Only knobs that differ from the
# current CLASS++ defaults are listed.
# Generated by benchmarks/precision/s23_write_pre.py, on the
# benchmarks/precision-campaign branch (the harness is kept off master;
# see pre/README.md).
back_integration_stepsize = 0.0007
recfast_Nz0 = 200000
recfast_z_initial = 40000
k_min_tau0 = 0.6
k_max_tau0_over_l_max = 1.2
k_step_super = 0.02
l_max_ncdm = 17
radiation_streaming_trigger_tau_over_tau_k = 240
radiation_streaming_trigger_tau_c_over_tau = 100
ur_fluid_trigger_tau_over_tau_k = 130
neglect_CMB_sources_below_visibility = 0.0001
tol_ncdm_synchronous = 1e-05
l_linstep = 15
transfer_neglect_delta_k_S_t0 = 100
transfer_neglect_delta_k_S_t1 = 0.5
transfer_neglect_delta_k_S_t2 = 1
q_logstep_limber = 1.01
hyper_sampling_flat = 16
delta_l_max = 250
