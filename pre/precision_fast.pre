# CLASS++ precision preset: fast -- cheapest useful setting
#
# WARNING -- LambdaCDM ONLY. Against each extended model's own converged
# reference this preset is WORSE than the defaults on w0CDM and on decaying
# CDM. Its advantage is specific to LambdaCDM; use precision_tuned.pre for
# anything else.
#
# Measured on 120 held-out Planck posterior draws, against a reference itself
# converged to S = 0.008:
#
#   S              0.5538   (spread of Delta chi^2; the headline metric)
#   bias           0.278 sigma
#   3-sigma worst  1.1523
#   cost           2.41x the speed of the defaults
#
# low-ell EE: this preset leaves k_step_super at the cheap rung, which puts
#   the ell = 2..29 EE residual at 2.71x the full-sky cosmic
#   variance of a multipole (chi^2-equivalent 32.3, against
#   0.0002 for the defaults). tau is measured there. Set
#       k_step_super = 0.002
#   before combining this with a low-ell EE likelihood; it costs ~10%.
#
# tensors: k_max_tau0_over_l_max = 1.2 truncates the k range
#   tensors need. Measured against a converged tensor reference, tensor BB
#   is ~11% wrong over ell = 30..300 (the defaults are 2.0%). Tensor TT is
#   unaffected. Set
#       k_max_tau0_over_l_max = 1.8
#   if you use tensor B-modes; it costs about 28%.
#
# lensing: delta_l_max = 250 halves the headroom the lensed spectrum
#   has at the top of the range you ask for. At l_max_scalars = 2500 the lensed
#   TT error reaches 7.5% in the last 50 multipoles (2.5% at delta_l_max = 500),
#   and raw_cl() returns a shorter array. Ask for l_max_scalars ~250 higher than
#   you need, or set delta_l_max = 500.
#
# P(k) with massive neutrinos: this preset keeps the campaign's neutrino
#   settings (ncdm_fluid_trigger_tau_over_tau_k = 15, l_max_ncdm = 10,
#   tol_ncdm_synchronous = 0.03), which put the linear P(k) 1.3e-3 low at
#   k = 1/Mpc and 3.8e-3 low at k = 5/Mpc. The compiled defaults dropped them on
#   2026-10-09. Delete those three lines if you use mPk with massive neutrinos.
#
# Calibrated for flat LambdaCDM + 2 massless nu + 1 massive NCDM,
# output = tCl,pCl,lCl with lensing, no mPk and no nonlinear correction.
# The nonlinear sector was never exercised. Only knobs that differ from the
# current CLASS++ defaults are listed.
# Generated by benchmarks/precision/s23_write_pre.py, on the
# benchmarks/precision-campaign branch (the harness is kept off master;
# see pre/README.md).
back_integration_stepsize = 0.007
tol_background_integration = 1e-05
tol_ncdm_bg = 1e-08
recfast_z_initial = 10000
k_min_tau0 = 0.6
k_max_tau0_over_l_max = 1.2
k_step_super = 0.02
k_step_transition = 0.8
tol_perturb_integration = 0.001
l_max_g = 8
l_max_pol_g = 6
l_max_ncdm = 10
ncdm_fluid_trigger_tau_over_tau_k = 15
tol_ncdm_synchronous = 0.03
q_logstep_spline = 900
l_logstep = 1.35
transfer_neglect_delta_k_S_e = 0.11
l_switch_limber = 4
hyper_sampling_flat = 7.6
delta_l_max = 250

# Pinned 2026-10-21, when the compiled cuts on the scalar CMB transfer functions became
# l-dependent: the constant cuts this file was measured with. See
# docs/superpowers/specs/2026-10-21-transfer-neglect-per-l-design.md.
transfer_neglect_delta_k_S_t0 = 0.15
transfer_neglect_delta_k_S_t1 = 0.04
transfer_neglect_delta_k_S_t2 = 0.12
transfer_neglect_l_half_S_t0 = 0
transfer_neglect_l_half_S_t1 = 0
transfer_neglect_l_half_S_t2 = 0
transfer_neglect_l_half_S_e = 0
