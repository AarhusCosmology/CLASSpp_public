# CLASS++ precision: the neutrino defaults as they were from 2026-08-21 to 2026-10-09.
#
# On 2026-10-09 three non-cold-relic knobs went back to their values from before
# 2026-08-21. The precision campaign of #397 had loosened them on a CMB-only
# objective with no P(k) in it, and there they cost the linear P(k) of every
# cosmology with massive neutrinos 1.3e-3 at k = 1/Mpc and 3.8e-3 at k = 5/Mpc
# (z = 0, the same for m_nu = 0.06 and 0.3 eV), against a converged run.
# Pass this file to reproduce a result computed in that period, or to bisect.
#
# The other knobs of #397 are unchanged; for the defaults from before 2026-08-21
# use precision_pre_2026_08_21.pre instead.
# See docs/superpowers/specs/2026-10-09-ncdm-precision-defaults-design.md.
ncdm_fluid_trigger_tau_over_tau_k = 15
l_max_ncdm = 10
tol_ncdm_synchronous = 0.03

# Added 2026-10-21: the constant transfer cuts of that period; see
# docs/superpowers/specs/2026-10-21-transfer-neglect-per-l-design.md.
transfer_neglect_delta_k_S_t0 = 0.15
transfer_neglect_delta_k_S_t1 = 0.04
transfer_neglect_delta_k_S_t2 = 0.12
transfer_neglect_delta_k_S_e = 1
transfer_neglect_l_half_S_t0 = 0
transfer_neglect_l_half_S_t1 = 0
transfer_neglect_l_half_S_t2 = 0
transfer_neglect_l_half_S_e = 0

# Added 2026-10-21, when the linear sources began to be continued past the last
# perturbation mode and the non-linear floor came down from 5 to 2/Mpc; see
# docs/superpowers/specs/2026-10-21-lensing-source-extrapolation-design.md.
nonlinear_min_k_max = 5
k_max_extrapolated = 0
extrapolation_method = 3

# Added 2026-10-27, when the C_l began to be sampled every 50 multipoles (the acoustic spline
# interpolates them as well as the cubic spline did every 30) and the lensing headroom went from
# 500 to 1000 multipoles, and the flat-space Bessel functions began to be sampled at 12 points per
# period instead of 8; see docs/superpowers/specs/2026-10-27-precision-sync-design.md. The k range of the scalar C_l
# changed rule the same day and no fixed key restores it: for lensed C_l pass
# k_max_tau0_above_l_max = 0.8 l_max_scalars + 900, without lensing 0. Dark energy fluids run
# rkdp45 since then: pass evolver_perturbations = 1 with a fluid to get ndf15 back. The
# radiation-streaming and visibility triggers went back towards their accurate values the
# same day (lensed EE had been 0.8% off a converged reference).
l_linstep = 40
delta_l_max = 500
radiation_streaming_trigger_tau_over_tau_k = 26
neglect_CMB_sources_below_visibility = 0.008
hyper_sampling_flat = 8
