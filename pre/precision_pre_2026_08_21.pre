# CLASS++ precision: the defaults as they were before 2026-08-21.
#
# The shipped defaults changed on 2026-08-21 to the configuration the precision
# campaign measured as both faster and more accurate. Pass this file to restore
# the previous behaviour exactly -- for reproducing an older result, or for
# bisecting a change in output against the defaults.
#
# Measured on the previous defaults: S = 1.725 against
# Planck 2018 plik_lite TTTEEE, at 2.16x the runtime of the
# current defaults. The current defaults measure S = 0.387.
#
# 25 knobs differ from the current defaults.
# Generated by benchmarks/precision/s23_write_pre.py, on the
# benchmarks/precision-campaign branch (the harness is kept off master;
# see pre/README.md).
back_integration_stepsize = 0.007
tol_background_integration = 1e-06
reionization_sampling = 0.05
thermo_rate_smoothing_radius = 50
recfast_z_initial = 10000
k_step_sub = 0.05
k_step_transition = 0.2
tol_perturb_integration = 1e-05
perturbations_sampling_boost_above_age_fraction = 0.9
start_small_k_at_tau_c_over_tau_h = 0.0015
tol_tau_approx = 1e-10
l_max_ncdm = 17
tight_coupling_trigger_tau_c_over_tau_k = 0.01
radiation_streaming_trigger_tau_over_tau_k = 45
ur_fluid_trigger_tau_over_tau_k = 30
ncdm_fluid_trigger_tau_over_tau_k = 31
neglect_CMB_sources_below_visibility = 0.001
tol_ncdm_synchronous = 0.0034
q_logstep_spline = 170
transfer_neglect_delta_k_S_t2 = 0.15
transfer_neglect_delta_k_S_e = 0.11
l_switch_limber = 10
k_max_limber_over_l_max_scalars = 0.001
q_logstep_limber = 1.025
hyper_phi_min_abs = 1e-10

# Added 2026-10-08, when recombination's defaults moved: the Planck-era RECFAST
# constants, HYREC-2 as distributed, and the Saha->ODE switches at 0.995. The x_e
# blend back towards Saha that went with them is gone and has no key (it moves
# lensed C_l by ~1e-4); see docs/superpowers/specs/2026-10-08-hyrec-helium-cosmorec-design.md.
recfast_calibration = planck
hyrec_calibration = none
recfast_x_He0_trigger = 0.995
recfast_x_H0_trigger = 0.995
recfast_x_H0_trigger2 = 0.995

# Added 2026-10-08, when the transfer module adopted class_public #267 and #268:
# the CMB lensing source sampled at the perturbation times only, and the
# line-of-sight integrals of number counts computed up to the largest q even
# where their time sampling aliases. With 'output = lCl' alone, the sources now
# start before recombination; that fix has no key. See
# docs/superpowers/specs/2026-10-08-transfer-restructure-design.md.
cmb_lensing_sampling_factor = 1e30
selection_sampling_bessel_min = 1e-30

# Added 2026-10-08, when HMcode 2020 became the HMcode of 'non_linear = hmcode',
# as in class_public (the key is read only with HMcode). The spline integrals of
# tools/arrays.cpp also subtract their curvature correction since then, which
# moves TT and EE by up to 2e-3 at l = 2, phiphi by 4e-3 near L = 50, lensed BB
# by 3e-3 and sigma8 by 6e-5; that fix has no key. Since 2026-10-09 the dark-energy
# correction of HMcode 2016 follows HMcode, which moves 2016 with a fluid or curvature
# (by 1.6e-2 for w0 = -0.9, wa = 0.1 and 1.4e-2 for Omega_k = 0.02); that has no key either.
# See docs/superpowers/specs/2026-10-08-hmcode-2020-design.md.
hmcode_version = 2016
