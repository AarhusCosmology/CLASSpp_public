# CLASS++ precision preset: act_dr6 -- ACT DR6 and SPT-3G D1, temperature, polarisation and lensing
#
# Pair it with, in your own input:
#   output = tCl,pCl,lCl      lensing = yes      non_linear = halofit (or hmcode)
#   l_max_scalars = 6327 with ACT-lite cut to the multipoles it uses (below), 9001 without
#
# Measured at two points through four likelihoods: ACT-lite, SPT-3G D1 lite (candl), ACT DR6 +
# Planck PR4 lensing (actplanck_baseline) and the phi-phi part of SPT-3G MUSE. The points are a
# LambdaCDM one (omega_b 0.0225, omega_cdm 0.1193, H0 67.6, n_s 0.974, tau 0.056, one 0.06 eV
# neutrino) and the best fit of self-interacting neutrinos + DRMD to the H0 World Cup data
# (three ncdm_self_interacting states, log10 G_eff = -2.86). Each number is the square root of
# (t - t_ref)^T C^-1 (t - t_ref) to a converged reference, a bound on the parameter shift in
# sigma along the worst direction; "all" is the four likelihoods together.
#
#                            ACT-lite   SPT  ACT lens  MUSE    all   one thread, l 6327
#   LambdaCDM   this file       0.09   0.08    0.02    0.01   0.12   4.8 s
#               defaults        0.16   0.11    0.02    0.01   0.19   1.5 s
#               until 10-29     0.10   0.08    0.04    0.04   0.14   7.6 s
#   SI nu+DRMD  this file       0.11   0.09    0.04    0.06   0.16   8.9 s
#               defaults        0.18   0.12    0.02    0.02   0.22   4.7 s
#               until 10-29     0.43   0.25    0.20    0.05   0.54  13.8 s
#
# (Apple M3 Pro.) At l_max_scalars = 9001 the spectra are as accurate and a run takes 7.4 s
# and 13.3 s. "Until 10-29" is this file as it was from 2026-09-30: its neutrino lines, the
# compiled values of 2026-08-21, put all three self-interacting neutrinos on a short, early
# truncated hierarchy, which in LambdaCDM only the one massive state had.
#
# ACT-lite asks for C_l to l = 9001, and never for less than 8503, but with its default cuts
# (600 to 6500) every window it uses is zero above l = 6325. Cutting the windows to where they
# are non-zero lowers the request to 6327 and leaves its chi^2 unchanged to the last bit; the
# other three ask for at most l = 5000 (MUSE, unlensed EE), 4095 (SPT) and 4000 (ACT lensing).
# The design note has the five lines of a Cobaya subclass that does it.
#
# Leave evolver_perturbations and tol_perturb_integration at the defaults. CLASS++ picks ndf15
# for self-interacting neutrinos + DRMD by itself, and tol_perturb_integration = 1e-7 moves the
# four likelihoods by at most 0.03 sigma (ACT-lite), none of them closer to the reference, while
# it doubles the run time.
#
# CLASS refuses a key given both here and in your input, so to change a line, copy this file
# and edit it. Not a posterior-averaged S like the other presets: two points. Not measured:
# ACT's multi-frequency likelihood (MFLike), and models other than these two.
# Design and every number: docs/superpowers/specs/2026-10-29-act-dr6-small-scale-preset-design.md
# (and, for the first version, docs/superpowers/specs/2026-09-30-act-dr6-precision-design.md).

# the damping tail: without each line, ACT-lite goes from 0.09 to the value given (LambdaCDM)
radiation_streaming_trigger_tau_over_tau_k = 240   # 0.12
perturb_sampling_stepsize = 0.05                   # 0.13, and SPT 0.08 -> 0.11
l_linstep = 20                                     # 0.11
delta_l_max = 1800                                 # 0.12, the lensing headroom

# lensing. The full-sky correlation function changes none of the four likelihoods by more
# than 0.001 sigma and costs 1.8 s of the 4.8 (1.9 of 8.9). It is kept for likelihoods that
# use lensed TT above l ~ 3500 without marginalising foregrounds over it, where the fast mode
# is 2% wrong at 3500 < l < 5000; drop it otherwise.
accurate_lensing = 1
# The perturbations are solved to 10/Mpc for the lensing source and halofit; beyond that the
# linear spectrum is continued in the high-k form of cold dark matter, which dark acoustic
# oscillations break. 70/Mpc changes none of the four likelihoods and costs 50% more.
nonlinear_min_k_max = 10
# no measurable effect on the two lensing likelihoods, and free; it keeps C_L^phiphi from
# scattering by 1e-3 at L > 1400 between runs that solve different k ranges
q_logstep_limber = 1.025

# recombination: CosmoRec, ACT DR6's baseline, is matched by both of CLASS++'s
# recombination codes by default since 2026-10-08 (recfast_calibration and
# hyrec_calibration = cosmorec; docs/superpowers/specs/2026-10-08-hyrec-helium-cosmorec-design.md).
# This file was measured with the RECFAST one.
